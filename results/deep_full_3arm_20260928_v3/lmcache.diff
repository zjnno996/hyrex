+++ b/tests/v1/multiprocess/run_deep_lookup_ablation.py
@@ -0,0 +1,92 @@
+"""Run the lookup-only ABBA ablation after the existing GPU-1 job finishes."""
+import json
+import os
+from pathlib import Path
+import statistics
+import subprocess
+import sys
+import time
+
+ROOT = Path('/root/hyrex_results/deep_lookup_abba_20260928_v1')
+PRIOR = Path('/root/hyrex_results/native_tail_abba_20260928_v3/status.json')
+FROZEN = Path('/root/hyrex_results/single_forward_3arm_4s10t_20260927_v1')
+SOURCE = str(Path(__file__).resolve().parents[3])
+
+
+def rows(path):
+    return [json.loads(s) for s in path.read_text().splitlines()]
+
+
+def status(state, **extra):
+    (ROOT / 'status.json').write_text(json.dumps(
+        dict(state=state, pid=os.getpid(), updated_unix=time.time(), **extra), indent=2))
+
+
+def main():
+    ROOT.mkdir(exist_ok=False)
+    status('waiting_for_native_tail')
+    while True:
+        previous = json.loads(PRIOR.read_text())
+        if previous['state'] == 'completed':
+            break
+        if previous['state'] != 'running':
+            raise RuntimeError(f'Previous experiment is not running/completed: {previous}')
+        os.kill(previous['pid'], 0)  # fail if predecessor vanished; do not hang forever
+        time.sleep(10)
+    reference = rows(FROZEN / 'baseline/online.jsonl')[:40]
+    summary, matched = {}, None
+    for index, enabled in enumerate(('0', '1', '1', '0')):
+        name = f'{index+1}_pipeline_{enabled}'
+        out = ROOT / name
+        out.mkdir()
+        command = json.loads((FROZEN / 'deep/command.json').read_text())
+        for key, value in {'--output-dir': str(out), '--online-repetitions': '1',
+                           '--experimental-lmcache-source': SOURCE}.items():
+            command[command.index(key)+1] = value
+        env = {k: v for k, v in os.environ.items() if 'HYREX' not in k and not k.startswith('LMCACHE_')}
+        env.update(PYTHONSAFEPATH='1', CUDA_VISIBLE_DEVICES='1',
+                   PYTHONPATH=f'{SOURCE}:/root/exp-vllm-single-forward',
+                   VLLM_HYREX_SINGLE_FORWARD='1', LMCACHE_HYREX_LAST_STATE_ONLY='1',
+                   LMCACHE_HYREX_FULL_LOAD_TO_STATE='0',
+                   LMCACHE_HYREX_BATCH_FULL_PAGES='1', LMCACHE_HYREX_COALESCE_FULL_PAGES='1',
+                   VLLM_HYREX_Q_ONLY_REPLAY='1', LMCACHE_HYREX_PIPELINE_LOOKUP=enabled)
+        (out / 'command.json').write_text(json.dumps(dict(command=command, pipeline=enabled), indent=2))
+        status('running', arm=name)
+        with (out / 'runner.log').open('w') as log:
+            subprocess.run(command, env=env, stdout=log, stderr=subprocess.STDOUT, check=True)
+        data, resets = rows(out / 'online.jsonl'), rows(out / 'resets.jsonl')
+        assert len(data) == 40 and len(resets) == 39 and all(r['success'] for r in resets)
+        assert len(rows(out / 'warmup.jsonl')) == 10
+        assert all((r['session_id'], r['turn_index'], r['prompt_tokens'], r['first_text']) ==
+                   (o['session_id'], o['turn_index'], o['prompt_tokens'], o['first_text'])
+                   for r, o in zip(data, reference)), 'Native first-token mismatch'
+        if matched is None:
+            matched = data
+        assert all(r['cached_tokens'] == o['cached_tokens'] for r, o in zip(data, matched))
+        log = (out / 'vllm.log').read_text().split('Successfully reset prefix cache')
+        assert len(log) >= 11
+        assert 'Triton kernel JIT compilation during inference' not in ''.join(log[10:])
+        summary[name] = dict(requests=40, checks_passed=True,
+                             continuation_mean_ttft_ms=statistics.mean(r['ttft_ms'] for r in data if r['turn_index']>0),
+                             all_mean_ttft_ms=statistics.mean(r['ttft_ms'] for r in data))
+        (ROOT / 'summary.json').write_text(json.dumps(summary, indent=2))
+        print(name, summary[name], flush=True)
+        time.sleep(5)
+    status('completed', requests=160)
+
+
+if __name__ == '__main__':
+    if '--launch' in sys.argv:
+        if ROOT.exists():
+            raise SystemExit('Output already exists')
+        with Path(str(ROOT)+'.driver.log').open('x') as log:
+            p = subprocess.Popen([sys.executable, '-u', __file__], stdin=subprocess.DEVNULL,
+                                 stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+        print('Queued independent driver', p.pid)
+    else:
+        try:
+            main()
+        except BaseException as exc:
+            if ROOT.exists():
+                status('failed', error=repr(exc))
+            raise
