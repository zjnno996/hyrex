+"""CPU-only checks using actual adapter methods without importing GPU services."""
+import ast
+import logging
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+
+def main():
+    os.environ.pop('LMCACHE_HYREX_COMBINED_LOOKUP', None)
+    source = Path(__file__).resolve().parents[3] / 'lmcache/integration/vllm/vllm_multi_process_adapter.py'
+    tree = ast.parse(source.read_text())
+    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'LMCacheMPSchedulerAdapter')
+    names = {'maybe_submit_lookup_request', 'check_lookup_result', 'check_lookup_results',
+             '_free_inconsistent_lookup_locks', 'submit_lookup_batch'}
+    methods = [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name in names]
+    for method in methods:
+        method.decorator_list = []
+    module = ast.Module(body=[ast.ImportFrom(module='__future__', names=[ast.alias(name='annotations')], level=0),
+                             ast.ClassDef(name='Adapter', bases=[], keywords=[], body=methods, decorator_list=[])], type_ignores=[])
+    events, answers = [], {}
+
+    def send(url, kind, args):
+        if kind in ('batch_lookup', 'batch_query'):
+            ids = args[0] if kind == 'batch_query' else [k.request_id for k in args[0]]
+            events.append(('send', kind, tuple(ids), url))
+            return SimpleNamespace(result=lambda timeout: (
+                [answers.get(('query', r, url), 1) for r in ids]
+                if kind == 'batch_query' else None))
+        request_id = args[0] if kind == 'query' else args[0].request_id
+        events.append(('send', kind, request_id, url))
+
+        def result(timeout):
+            events.append(('wait', kind, request_id, url))
+            value = answers.get((kind, request_id, url), 1)
+            if isinstance(value, Exception):
+                raise value
+            return value
+        return SimpleNamespace(result=result)
+
+    ns = {'os': os, 'logger': logging.getLogger(__name__), 'send_lmcache_request': send,
+          'RequestType': SimpleNamespace(LOOKUP_GROUPS='lookup', LOOKUP='lookup',
+                                        HYREX_LOOKUP_BATCH='batch_lookup', HYREX_QUERY_BATCH='batch_query',
+                                        QUERY_PREFETCH_STATUS='query',
+                                        FREE_LOOKUP_LOCKS_GROUPS='free', FREE_LOOKUP_LOCKS='free')}
+    exec(compile(ast.fix_missing_locations(module), str(source), 'exec'), ns)
+
+    def adapter(urls=('server',)):
+        a = ns['Adapter']()
+        a.is_healthy = True
+        a._server_urls = list(urls)
+        a.mq_clients = {u: u for u in urls}
+        a._pending_lookups = set()
+        for name in ('_lookup_chunk_sizes', '_lookup_params', '_lookup_groups',
+                     '_finished_lookup_results', '_per_server_hits'):
+            setattr(a, name, {})
+        a._health_events = {u: SimpleNamespace(clear=lambda: setattr(a, 'is_healthy', False)) for u in urls}
+        a._mq_timeout = 1
+        a.lmcache_tokens_per_chunk = 528
+        a.tp_size = 1
+        a._ensure_heartbeat_started = lambda: None
+
+        def key(*args, **kwargs):
+            obj = SimpleNamespace(**kwargs)
+            obj.no_worker_id_version = lambda: obj
+            return obj
+        a._create_key = key
+        return a
+
+    a = adapter()
+    waits = []
+    for request_id, chunk, group in [('state', 528, 1), ('full', 16, 0)]:
+        a.maybe_submit_lookup_request(request_id, list(range(831)), 'tenant', [group], chunk, waits)
+    assert len(events) == 2 and all(e[0] == 'send' for e in events)
+    assert not a._pending_lookups  # no premature hit publication
+    for finish in waits:
+        finish()
+    assert a._lookup_chunk_sizes == {'state': 528, 'full': 16}
+    assert a._lookup_groups == {'state': [1], 'full': [0]}
+    answers.update({('query', 'state', 'server'): 1, ('query', 'full', 'server'): 47})
+    events.clear()
+    assert a.check_lookup_results(['state', 'full']) == [528, 752]
+    assert [e[0] for e in events] == ['send', 'send', 'wait', 'wait']
+    events.clear()
+    assert a.check_lookup_results(['state', 'full']) == [528, 752]
+    assert events == []  # cached result must not consume server result again
+
+    a = adapter()
+    a.maybe_submit_lookup_request('pending', [1]*1056)
+    answers[('query', 'pending', 'server')] = None
+    assert a.check_lookup_results(['pending', 'missing']) == [None, 0]
+    answers[('query', 'pending', 'server')] = 2
+    assert a.check_lookup_results(['pending']) == [1056]
+
+    a = adapter(('a', 'b'))
+    a.maybe_submit_lookup_request('multi', [1]*1584, object_group_ids=[1])
+    answers.update({('query', 'multi', 'a'): 2, ('query', 'multi', 'b'): 3})
+    events.clear()
+    assert a.check_lookup_results(['multi']) == [1056]
+    assert any(e[1] == 'free' and e[3] == 'b' for e in events)
+
+    a = adapter()
+    answers[('lookup', 'timeout', 'server')] = TimeoutError()
+    waits = []
+    a.maybe_submit_lookup_request('timeout', [1]*528, deferred_waits=waits)
+    waits[0]()
+    assert not a.is_healthy and 'timeout' not in a._pending_lookups
+    assert a.check_lookup_results(['timeout']) == [0]
+    os.environ['LMCACHE_HYREX_COMBINED_LOOKUP'] = '1'
+    a = adapter()
+    waits, batch = [], []
+    events.clear()
+    for r, chunk in [('state', 528), ('full', 16)]:
+        a.maybe_submit_lookup_request(r, [1]*831, object_group_ids=[0], chunk_size=chunk,
+                                      deferred_waits=waits, batch_submissions=batch)
+    assert events == []
+    a.submit_lookup_batch(batch)
+    for finish in waits:
+        finish()
+    assert a.check_lookup_results(['state', 'full']) == [528, 752]
+    assert [e[1] for e in events] == ['batch_lookup', 'batch_query']
+    events.clear()
+    assert a.check_lookup_results(['state', 'full']) == [528, 752] and not events
+    os.environ.pop('LMCACHE_HYREX_COMBINED_LOOKUP')
+    print('PASS: pipelining, independent boundaries, cached/pending/missing results, multi-server locks, timeout')
+
+
+if __name__ == '__main__':
+    main()
